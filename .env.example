# Jev and the comparison LLM both go through OpenRouter (one key, one bill).
OPENROUTER_API_KEY=sk-or-v1-...
# Or a direct TypeSafe account: TYPESAFE_API_KEY=jv_live_... and JEV_BASE_URL=https://api.typesafe.ai
JEV_BASE_URL=https://openrouter.ai/api
JEV_MODEL=jev-latest

# The LLM that fills arguments / writes the answer (any OpenRouter model id).
LLM_MODEL=anthropic/claude-sonnet-5

# Offline mode: 1 = keyword fakes instead of real calls. Decisions/answers are NOT real,
# token counts are estimated from the real payloads.
JEV_FAKE=0
LLM_FAKE=0
